<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F4"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="32dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DANA Notif Bridge"
            android:textColor="#101410"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notifikasi DANA → gateway QRIS alldayPay"
            android:textColor="#8A938C"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />

        <!-- Status card -->
        <LinearLayout
            android:id="@+id/cardStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_status"
            android:backgroundTint="#0B3D2C"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvStatusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bridge aktif"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatusDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Menyimak notifikasi DANA…"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="GERBANG  •  /internal/notification"
                android:textColor="#66FFFFFF"
                android:textSize="10sp"
                android:letterSpacing="0.14" />
        </LinearLayout>

        <!-- Permission row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_row"
            android:layout_marginTop="10dp"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textColor="#0B3D2C"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingEnd="10dp" />

            <TextView
                android:id="@+id/tvPerm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Izin Notification Access aktif (ketuk untuk setting)"
                android:textColor="#37413A"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Switch row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_row"
            android:layout_marginTop="10dp"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bridge aktif"
                    android:textColor="#101410"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Matikan sementara tanpa hapus setting"
                    android:textColor="#8A938C"
                    android:textSize="11sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/swEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Config card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginTop="10dp"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GATEWAY URL"
                android:textColor="#8A938C"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <EditText
                android:id="@+id/etUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="http://192.168.1.17:3000"
                android:inputType="textUri"
                android:textColor="#101410"
                android:textSize="15sp"
                android:backgroundTint="#E2E8E4"
                android:paddingTop="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="NOTIF_SECRET"
                android:textColor="#8A938C"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <EditText
                android:id="@+id/etSecret"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="secret dari .env gateway"
                android:inputType="textPassword"
                android:textColor="#101410"
                android:textSize="15sp"
                android:backgroundTint="#E2E8E4"
                android:paddingTop="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="INTERVAL HEARTBEAT (MENIT)"
                android:textColor="#8A938C"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <EditText
                android:id="@+id/etInterval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="3"
                android:inputType="number"
                android:textColor="#101410"
                android:textSize="15sp"
                android:backgroundTint="#E2E8E4"
                android:paddingTop="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Ping GET /internal/ping ke gateway tiap N menit (default 3, alert gateway di 15 menit)"
                android:textColor="#8A938C"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp">

                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_primary"
                    android:text="Simpan"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@null" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/btnTest"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_secondary"
                    android:text="Tes koneksi"
                    android:textAllCaps="false"
                    android:textColor="#0B3D2C"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- Log card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginTop="10dp"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LOG PENGIRIMAN"
                    android:textColor="#8A938C"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <Button
                    android:id="@+id/btnClear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:minWidth="0dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:text="bersihkan"
                    android:textAllCaps="false"
                    android:textColor="#0B3D2C"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_log"
                android:fontFamily="monospace"
                android:padding="14dp"
                android:lineSpacingExtra="4dp"
                android:text="(belum ada aktivitas)"
                android:textColor="#4B554D"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
